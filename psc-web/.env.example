NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_SESSION_SECRET=change-me-with-at-least-32-characters

# MVP deploy path:
# Bitrix authenticates the user; Next.js server routes enforce PSC permissions.
# Keep this service role key server-only. Never expose it with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Future hardening path:
# Add a publishable key only after browser/RLS-backed Supabase access is implemented.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_or_anon_key

BITRIX_CLIENT_ID=local-or-marketplace-app-client-id
BITRIX_CLIENT_SECRET=local-or-marketplace-app-client-secret
# User authorization starts at your Bitrix24 portal, not at oauth.bitrix.info.
BITRIX_PORTAL_URL=https://your-portal.bitrix24.com.br
# Keep this central OAuth token endpoint as-is unless Bitrix documentation changes.
BITRIX_OAUTH_TOKEN_URL=https://oauth.bitrix.info/oauth/token/
BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.com.br/rest/1/webhook/
